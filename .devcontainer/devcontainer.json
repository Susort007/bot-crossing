{
  "name": "Bot Crossing",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "forwardPorts": [5274],
  "portsAttributes": {
    "5274": {
      "label": "Bot Crossing (private demo)",
      "onAutoForward": "notify",
      "visibility": "private",
      "protocol": "http"
    }
  },
  "containerEnv": { "BOT_CROSSING_DEMO": "1" },
  "postCreateCommand": "npm ci --no-audit --no-fund",
  "customizations": { "vscode": { "settings": { "remote.autoForwardPorts": false } } }
}
